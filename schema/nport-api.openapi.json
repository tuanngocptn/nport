                  "LEASE_EXPIRED",
                  "CLIENT_TOO_OLD",
                  "POW_REQUIRED",
                  "RATE_LIMITED",
                  "CONCURRENCY_LIMIT",
                  "CREATE_QUOTA_EXCEEDED",
                  "PROVISION_FAILED",
                  "INTERNAL",
                  "UPSTREAM_CLOUDFLARE_ERROR",
                  "CAPACITY_EXHAUSTED",
                  "LOCAL_PORT_CLOSED",
                  "LOCAL_PORT_INVALID",
                  "CONFIG_UNREADABLE",
                  "CONFIG_UNWRITABLE",
                  "EDGE_DISCOVERY_FAILED",
                  "EDGE_CONNECT_FAILED",
                  "EDGE_REGISTRATION_REFUSED",
                  "EDGE_PROTOCOL_ERROR",
                  "TUNNEL_LOST",
                  "LOCAL_REQUEST_FAILED",
                  "SHUTDOWN_TIMEOUT"
