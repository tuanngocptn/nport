  "components": {
    "schemas": {
      "ChallengeResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "challenge": {
            "type": "string",
            "description": "Opaque, HMAC-signed, self-validating. Nothing is stored server-side."
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32,
            "description": "Required leading zero bits. Raised under load."
          },
          "expiresAt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "After this, solving it is pointless."
          }
        },
        "required": [
          "challenge",
          "difficulty",
          "expiresAt"
        ],
        "description": "A stateless proof-of-work challenge."
      },
      "ClientKind": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "enum": [
          "cli",
          "desktop"
        ],
        "description": "Which client is calling."
      },
      "CreateTunnelRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "subdomain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 95,
            "description": "Desired subdomain. Normalized server-side; omit to have one generated."
          },
          "challenge": {
            "type": "string",
            "description": "The `challenge` value from `GET /v1/challenge`."
          },
          "nonce": {
            "type": "string",
            "description": "A solution satisfying the challenge's difficulty."
          },
          "client": {
            "type": "string",
            "enum": [
              "cli",
              "desktop"
            ],
            "description": "Which client is calling."
          }
        },
        "required": [
          "challenge",
          "nonce",
          "client"
        ],
        "description": "Claim a subdomain and provision a tunnel."
      },
      "CreateTunnelResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "subdomain": {
            "type": "string",
            "minLength": 3,
            "maxLength": 63,
            "description": "The normalized subdomain that was claimed."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The public HTTPS URL. Ready within a few seconds, not instantly."
          },
          "tunnelId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Cloudflare's tunnel UUID."
          },
          "tunnelToken": {
            "type": "string",
            "description": "Connector credential. Returned ONCE. Never logged, never in argv."
          },
          "ownerToken": {
            "type": "string",
            "description": "256-bit bearer proof for this lease. Returned ONCE; only its SHA-256 is stored."
          },
          "expiresAt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Server-authoritative. The client only displays it."
          }
        },
        "required": [
          "subdomain",
          "url",
          "tunnelId",
          "tunnelToken",
          "ownerToken",
          "expiresAt"
        ],
        "description": "A provisioned tunnel. Both tokens are shown exactly once."
      },
      "HeartbeatRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ownerToken": {
            "type": "string",
            "description": "Proves this caller created the lease."
          }
        },
        "required": [
          "ownerToken"
        ],
        "description": "Renew a lease."
      },
      "HeartbeatResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "expiresAt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Authoritative. Clients correct their countdown from this rather than counting locally."
          }
        },
        "required": [
          "expiresAt"
        ],
        "description": "The lease's current expiry."
      },
      "DeleteTunnelRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ownerToken": {
            "type": "string"
