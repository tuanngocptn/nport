          },
          "tunnelDurationMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "heartbeatIntervalMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "powDifficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "maxConcurrentPerSource": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "maxCreatesPerHourPerSource": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "minClientVersion",
          "tunnelDurationMs",
          "heartbeatIntervalMs",
          "powDifficulty",
          "maxConcurrentPerSource",
          "maxCreatesPerHourPerSource"
        ],
        "description": "Limits, discovered rather than hardcoded, so they can be tuned without a client release."
      },
      "Error": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
