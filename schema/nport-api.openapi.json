            "description": "Milliseconds since the Unix epoch, UTC."
          }
        },
        "required": [
          "subdomain",
          "active"
        ],
        "description": "Public status. Deliberately carries nothing an attacker could use."
      },
      "MetaResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "minClientVersion": {
            "type": "string",
