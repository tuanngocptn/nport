{
  // The control plane at api.nport.link (apps/api/CLAUDE.md).
  // The repo is the source of truth for both custom domains — not the dashboard
  // (docs/OPERATIONS.md § Inventory).
  //
  // No secret belongs in this file. CF_API_TOKEN, CF_ACCOUNT_ID, CF_ZONE_ID, CF_DOMAIN,
  // POW_SECRET, and IP_HASH_SECRET are generated by Terraform and pushed with
  // `wrangler secret bulk` after each deploy (ADR-0040, docs/OPERATIONS.md § Secrets).
  "name": "nport-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "api.nport.link", "custom_domain": true }],

  // **The control plane is reachable at its custom domain and nowhere else.** A workers.dev
  // hostname would answer the same routes while sitting outside the zone, where the edge
  // rate-limit ruleset in infra/terraform does not apply and `cf-connecting-ip` is the only
  // thing standing between an abuser and the create path. Three of the four layers in
  // docs/ARCHITECTURE.md §7 are zone-scoped; this keeps the door they guard the only door.
  "workers_dev": false,

  "durable_objects": {
    "bindings": [
      { "name": "SUBDOMAIN_LEASE", "class_name": "SubdomainLease" },
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "SOURCE_QUOTA", "class_name": "SourceQuota" }
    ]
  },

  // SQLite-backed, so free-plan eligible (ADR-0011). Migrations are forward-only:
  // `wrangler rollback` reverts code, not schema (docs/RELEASE.md). A new class gets a
  // new tag rather than being appended to an existing one — v1 has never been applied
  // anywhere, so amending it would work, but immutable-once-committed is the habit that
  // stays correct after the first deploy.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SubdomainLease", "Registry"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SourceQuota"]
    }
  ],

  // Per-source request limiting, keyed on HMAC(ip, secret) + ASN — never a raw IP
  // (docs/ARCHITECTURE.md §7). `namespace_id` is ours to choose; it only separates one
  // counter from another. `period` accepts **10 or 60 and nothing else**, which is a
  // property of the platform, not a choice: the schema in the pinned wrangler enumerates
  // exactly those two values.
  //
  // This is the outermost of the layered controls and the cheapest to evaluate. It does
  // not replace the per-source caps below: it bounds request *rate*, while the caps bound
  // how many tunnels a source can hold and create.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  // Reconciliation only — orphan tunnels and DNS records with no lease. Expiry is
  // driven by each lease's own DO alarm (docs/ARCHITECTURE.md §3e, §3f).
  "triggers": { "crons": ["*/5 * * * *"] },

  // Limits live here so they are reviewable, and are surfaced by GET /v1/meta so
  // clients discover them instead of hardcoding them (apps/api/CLAUDE.md).
  "vars": {
    "LEASE_TTL_SECONDS": 14400,
    "HEARTBEAT_GRACE_SECONDS": 120,
    "MAX_ACTIVE_TUNNELS": 1000,
    "MIN_CLIENT_VERSION": "3.0.0",
    // The floor every caller pays: ~100 ms of work for a first tunnel. A source that
    // keeps creating pays more, automatically, up to POW_MAX_DIFFICULTY_BITS.
    "POW_DIFFICULTY_BITS": 20,
    // The ceiling on automatic escalation. 26 bits is ~64x the floor — expensive enough
    // to stop a script, still finite for someone with a legitimate reason to hold many
    // tunnels. Raising the *floor* is the manual lever during an incident
    // (docs/OPERATIONS.md § Mass abuse).
    "POW_MAX_DIFFICULTY_BITS": 26,
    // Per-source caps. Surfaced by GET /v1/meta so clients discover them rather than
    // hardcoding them — v2's CLI hardcoded its one limit and was wrong about it (R6).
    "MAX_CONCURRENT_PER_SOURCE": 3,
    "MAX_CREATES_PER_HOUR_PER_SOURCE": 20
  },

  // The staging deployment, on a **separate Cloudflare account** with its own zone (ADR-0038).
  // `CLOUDFLARE_ACCOUNT_ID` in the deploy workflow selects which account this lands in; nothing here
  // names it, so the same file cannot deploy to the wrong one by editing a constant.
  //
  // **Every `vars` key is repeated below, and that is not redundancy.** Wrangler marks `vars` as
  // `notInheritable`: an environment's block *replaces* the top-level one rather than merging with
  // it. Listing only the keys that differ would leave staging with three vars and no
  // `LEASE_TTL_SECONDS`, no caps, no `MIN_CLIENT_VERSION` — and `GET /v1/meta` would answer with
  // whatever `env.ts` falls back to while looking entirely healthy. `pnpm deploy:check` diffs the
  // resolved var names between environments so a key added to one and forgotten in the other fails
  // before it reaches an account.
  //
  // Two values differ on purpose, both because staging exists to be exercised rather than defended:
  // a shorter lease so a leaked test tunnel expires within the hour, and a lower proof-of-work floor
  // so an end-to-end run is not spending seconds per create.
  "env": {
    "staging": {
      // **The same name as production, deliberately.** Staging and production are separate
      // Cloudflare accounts (ADR-0038), so the account is the isolation and a name suffix would
      // only make the two deployments differ in a way nothing else does. Identical names mean the
      // dashboards, the logs and the docs read the same in both places.
      //
      // Wrangler defaults an environment's name to `<name>-<env>`, so this line is what stops
      // that. The account comes from CLOUDFLARE_ACCOUNT_ID, scoped per GitHub Environment.
      "name": "nport-api",
      "routes": [{ "pattern": "api.nport.online", "custom_domain": true }],
      "workers_dev": false,
      "observability": { "enabled": true },
      "triggers": { "crons": ["*/5 * * * *"] },
      "durable_objects": {
        "bindings": [
          { "name": "SUBDOMAIN_LEASE", "class_name": "SubdomainLease" },
          { "name": "REGISTRY", "class_name": "Registry" },
          { "name": "SOURCE_QUOTA", "class_name": "SourceQuota" }
        ]
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "vars": {
        "LEASE_TTL_SECONDS": 3600,
        "HEARTBEAT_GRACE_SECONDS": 120,
        "MAX_ACTIVE_TUNNELS": 100,
        // **Staging accepts any version, and production must not.**
        //
        // The gate sorts a pre-release *below* its release, so the in-development client
        // — `3.0.0-dev` — is refused by a `3.0.0` floor. That is right for production and
        // fatal for staging, whose entire purpose is exercising the build that is not
        // released yet. A floor of `3.0.0-dev` would not do either: pre-release tags are
        // compared as strings, so `3.0.0-beta.1` sorts below `3.0.0-dev` and every beta
        // would be refused the moment Phase 3 starts shipping them.
        //
        // The gate's own logic is covered by unit tests; staging is here to test tunnels.
        "MIN_CLIENT_VERSION": "0.0.0",
        "POW_DIFFICULTY_BITS": 16,
        "POW_MAX_DIFFICULTY_BITS": 22,
        "MAX_CONCURRENT_PER_SOURCE": 3,
        // **Higher than production on purpose.** The cap exists to stop one source minting
        // tunnels in bulk; on staging that traffic shape is exactly what we want, since the
        // live smoke test costs one create per run per OS and a failed run costs one too.
        // Twenty is roughly an afternoon of debugging from a single address — it locked the
        // maintainer out of the environment on its first day.
        "MAX_CREATES_PER_HOUR_PER_SOURCE": 60
      }
    }
  }
}
