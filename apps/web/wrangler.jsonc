{
  // The public site at nport.link, built by Next.js and adapted by OpenNext (ADR-0006).
  //
  // The output paths below are load-bearing: getting them wrong deploys an empty site
  // that still returns 200 (apps/web/CLAUDE.md § Gotchas). Nothing here is committed —
  // `.open-next/` is generated by `pnpm --filter @nport/web build`.
  "name": "nport-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // Both hostnames, so the apex cutover from the Pages project is a repo change with a
  // rollback path (docs/OPERATIONS.md § Pages → Workers cutover).
  "routes": [
    { "pattern": "nport.link", "custom_domain": true },
    { "pattern": "www.nport.link", "custom_domain": true }
  ],

  // Staging, on the separate account (ADR-0038). No `vars` here to repeat — the site has none — but
  // the same `notInheritable` rule would apply the moment one is added, so add it to both blocks.
  "env": {
    "staging": {
      "name": "nport-web-staging",
      "routes": [
        { "pattern": "nport.online", "custom_domain": true },
        { "pattern": "www.nport.online", "custom_domain": true }
      ],
      "observability": { "enabled": true },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      }
    }
  }

  // No KV or R2 incremental cache: the site is static content plus generated error
  // pages, with no ISR. Add one only if a route genuinely needs revalidation.
}
