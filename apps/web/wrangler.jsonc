{
  // The public site at nport.link, built by Next.js and adapted by OpenNext (ADR-0006).
  //
  // The output paths below are load-bearing: getting them wrong deploys an empty site
  // that still returns 200 (apps/web/CLAUDE.md § Gotchas). Nothing here is committed —
  // `.open-next/` is generated by `pnpm --filter @nport/web build:worker`.
  "name": "nport-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // Both hostnames, so the apex cutover from the Pages project is a repo change with a
  // rollback path (docs/OPERATIONS.md § Pages → Workers cutover).
  // Off for the same reason as the API, plus one of its own: a second hostname serving the
  // same marketing pages is duplicate content the site's canonical tags do not cover.
  "workers_dev": false,
  "routes": [
    { "pattern": "nport.link", "custom_domain": true },
    { "pattern": "www.nport.link", "custom_domain": true }
  ],

  // Staging, on the separate account (ADR-0038). No `vars` here to repeat — the site has none — but
  // the same `notInheritable` rule would apply the moment one is added, so add it to both blocks.
  "env": {
    "staging": {
      // **The same name as production, deliberately.** Staging and production are separate
      // Cloudflare accounts (ADR-0038), so the account is the isolation and a name suffix would
      // only make the two deployments differ in a way nothing else does. Identical names mean the
      // dashboards, the logs and the docs read the same in both places.
      //
      // Wrangler defaults an environment's name to `<name>-<env>`, so this line is what stops
      // that. The account comes from CLOUDFLARE_ACCOUNT_ID, scoped per GitHub Environment.
      "name": "nport-web",
      "workers_dev": false,
      "routes": [
        { "pattern": "nport.online", "custom_domain": true },
        { "pattern": "www.nport.online", "custom_domain": true }
      ],
      "observability": { "enabled": true },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      }
    }
  }

  // No KV or R2 incremental cache: the site is static content plus generated error
  // pages, with no ISR. Add one only if a route genuinely needs revalidation.
}
