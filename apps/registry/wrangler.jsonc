{
  // The node directory (apps/registry/CLAUDE.md, ADR-0031). **Master deployments only** — a node
  // operator never deploys this Worker at all.
  //
  // **This Worker holds no Cloudflare credentials**, which is the point of splitting it out: it
  // provisions nothing, so there is no API token, no account id and no zone id to protect here.
  // POW_SECRET is its only secret, generated by Terraform and pushed with `wrangler secret bulk`
  // after each deploy (ADR-0040, docs/OPERATIONS.md § Secrets). It must **differ** from apps/node's,
  // or a challenge issued by a node would be redeemable here.
  "name": "nport-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // **No route, and no workers.dev hostname: reachable only through apps/gateway's service binding**
  // (ADR-0049), which dispatches everything under `/v1/nodes*` here. That is the whole basis on
  // which src/middleware/forwarded.ts believes the identity it is handed — give this Worker a public
  // address and any caller could set their own x-nport-source-hash. `pnpm deploy:check` fails the
  // deploy if either line comes back.
  "workers_dev": false,

  "durable_objects": {
    "bindings": [{ "name": "DIRECTORY", "class_name": "Directory" }]
  },

  // SQLite-backed, so free-plan eligible (ADR-0011). Forward-only: `wrangler rollback` reverts
  // code, not schema (docs/RELEASE.md).
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Directory"]
    }
  ],

  // No `ratelimits` binding: the gateway does the limiting for all three Workers (namespace 1003).
  // Applying it here too would charge one caller against two counters for one request.

  // Age every listing and delist the long-silent — no fetches (ADR-0049). Five minutes matches the
  // node's cron so the two schedules are one number to reason about, and it is well inside the
  // window a client's cached list is allowed to be stale.
  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    "MIN_CLIENT_VERSION": "3.0.0",
    // A registration costs the same floor as a tunnel create. There is no per-source escalation
    // here — the directory has no equivalent of "this source keeps creating", because a node
    // registers once and refreshes, so ADR-0028's dial has nothing to turn.
    "POW_DIFFICULTY_BITS": 20,
    // How long a client should reuse its cached node list, published by GET /v1/nodes so clients
    // discover it rather than hardcoding one (the same argument as ADR-0037's heartbeat interval).
    // Five minutes: long enough that the directory is not on the hot path, short enough that a new
    // node is discoverable within one cron cycle of registering.
    "NODE_LIST_REFRESH_MS": 300000,
    // Silence after which a node reads as `down` but stays listed, so a client shows it greyed out
    // rather than having it vanish (docs/FEATURES.md §3). 900 s is three missed heartbeats at the
    // node's five-minute cron — one blip must not hide a healthy node.
    //
    // **Seconds, not failure counts** (ADR-0049). A counter only means anything to whoever was
    // counting, and nothing is: the registry no longer probes. A node's own `last_seen_at` is a
    // timestamp it supplied, so a cron run this Worker misses shifts a status by one interval
    // instead of losing a failure's worth of history.
    "NODE_DOWN_AFTER_SECONDS": 900,
    // ...and before the row is deleted outright. Two hours: long enough for an operator to fix a
    // deploy without re-registering, short enough that the list is not a graveyard. Re-registering
    // is cheap anyway — one PoW solve on the next cron tick.
    "NODE_DELIST_AFTER_SECONDS": 7200,
    // The ceiling on how many nodes the directory will hold. A bound rather than a target: open
    // enrolment means the row count is attacker-influenced. Refusals past this are
    // CAPACITY_EXHAUSTED.
    "MAX_NODES": 200
  },

  // Staging, on a separate Cloudflare account (ADR-0038). **Every `vars` key is repeated**, because
  // wrangler marks `vars` as `notInheritable`: an environment's block replaces the top-level one
  // rather than merging, so a key listed in one and forgotten in the other resolves to whatever
  // `env.ts` falls back to while looking healthy. `pnpm deploy:check` diffs the resolved names.
  "env": {
    "staging": {
      // The same name as production, deliberately — the account is the isolation (ADR-0038).
      "name": "nport-registry",
      "workers_dev": false,
      "observability": { "enabled": true },
      "triggers": { "crons": ["*/5 * * * *"] },
      "durable_objects": {
        "bindings": [{ "name": "DIRECTORY", "class_name": "Directory" }]
      },
      "vars": {
        // Staging accepts any client version, and production must not — the gate sorts a
        // pre-release below its release, so a `3.0.0` floor refuses the `3.0.0-dev` build that
        // staging exists to exercise. Same reasoning, and the same value, as apps/node's.
        "MIN_CLIENT_VERSION": "0.0.0",
        "POW_DIFFICULTY_BITS": 16,
        "NODE_LIST_REFRESH_MS": 60000,
        "NODE_DOWN_AFTER_SECONDS": 600,
        // Shorter than production: a staging node is expected to come and go, and a two-hour
        // graveyard makes the list harder to read than the thing it is testing.
        "NODE_DELIST_AFTER_SECONDS": 1800,
        "MAX_NODES": 20
      }
    }
  }
}
