{
  // The node directory at registry.nport.link (apps/registry/CLAUDE.md, ADR-0031).
  //
  // **This Worker holds no Cloudflare credentials**, which is the point of splitting it out: it
  // provisions nothing, so there is no API token, no account id and no zone id to protect here.
  // POW_SECRET and IP_HASH_SECRET are its only secrets, generated by Terraform and pushed with
  // `wrangler secret bulk` after each deploy (ADR-0040, docs/OPERATIONS.md § Secrets).
  "name": "nport-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "registry.nport.link", "custom_domain": true }],

  // Same reasoning as apps/api: a workers.dev hostname would answer these routes from outside the
  // zone, where the edge rate-limit ruleset in infra/terraform does not apply.
  "workers_dev": false,

  "durable_objects": {
    "bindings": [{ "name": "DIRECTORY", "class_name": "Directory" }]
  },

  // SQLite-backed, so free-plan eligible (ADR-0011). Forward-only: `wrangler rollback` reverts
  // code, not schema (docs/RELEASE.md).
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Directory"]
    }
  ],

  // Per-source request limiting, keyed on HMAC(ip, secret) + ASN — never a raw IP. `namespace_id`
  // only separates one counter from another, and it is deliberately **not** 1001: that is
  // apps/api's, and two Workers sharing a namespace would have their callers share a bucket.
  //
  // `period` accepts 10 or 60 and nothing else, which is a property of the platform.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  // Probe every listed node and delist the long-dead. Five minutes matches apps/api's cron so the
  // two Workers' schedules are one number to reason about, and it is well inside the window a
  // client's cached list is allowed to be stale.
  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    "MIN_CLIENT_VERSION": "3.0.0",
    // A registration costs the same floor as a tunnel create. There is no per-source escalation
    // here — the directory has no equivalent of "this source keeps creating", because a node
    // registers once and refreshes, so ADR-0028's dial has nothing to turn.
    "POW_DIFFICULTY_BITS": 20,
    // How long a client should reuse its cached node list, published by GET /v1/nodes so clients
    // discover it rather than hardcoding one (the same argument as ADR-0037's heartbeat interval).
    // Five minutes: long enough that the directory is not on the hot path, short enough that a new
    // node is discoverable within one cron cycle of registering.
    "NODE_LIST_REFRESH_MS": 300000,
    // Consecutive failed probes before a node is called `down` and stops being offered. Three, so a
    // single blip does not hide a healthy node — at a five-minute cron that is fifteen minutes.
    "PROBE_FAILURES_BEFORE_DOWN": 3,
    // ...and before its row is deleted outright. 24 failures is two hours: long enough for an
    // operator to fix a deploy without re-registering, short enough that the list is not a
    // graveyard. Re-registering is cheap anyway — it is one PoW solve.
    "PROBE_FAILURES_BEFORE_DELIST": 24,
    // The ceiling on how many nodes the directory will hold. A bound rather than a target: open
    // enrolment means the row count is attacker-influenced, and every cron run probes every node,
    // so an unbounded list is an unbounded cron. Refusals past this are CAPACITY_EXHAUSTED.
    "MAX_NODES": 200
  },

  // Staging, on a separate Cloudflare account (ADR-0038). **Every `vars` key is repeated**, because
  // wrangler marks `vars` as `notInheritable`: an environment's block replaces the top-level one
  // rather than merging, so a key listed in one and forgotten in the other resolves to whatever
  // `env.ts` falls back to while looking healthy. `pnpm deploy:check` diffs the resolved names.
  "env": {
    "staging": {
      // The same name as production, deliberately — the account is the isolation (ADR-0038).
      "name": "nport-registry",
      "routes": [{ "pattern": "registry.nport.online", "custom_domain": true }],
      "workers_dev": false,
      "observability": { "enabled": true },
      "triggers": { "crons": ["*/5 * * * *"] },
      "durable_objects": {
        "bindings": [{ "name": "DIRECTORY", "class_name": "Directory" }]
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "vars": {
        // Staging accepts any client version, and production must not — the gate sorts a
        // pre-release below its release, so a `3.0.0` floor refuses the `3.0.0-dev` build that
        // staging exists to exercise. Same reasoning, and the same value, as apps/api's.
        "MIN_CLIENT_VERSION": "0.0.0",
        "POW_DIFFICULTY_BITS": 16,
        "NODE_LIST_REFRESH_MS": 60000,
        "PROBE_FAILURES_BEFORE_DOWN": 2,
        // Shorter than production: a staging node is expected to come and go, and a two-hour
        // graveyard makes the list harder to read than the thing it is testing.
        "PROBE_FAILURES_BEFORE_DELIST": 6,
        "MAX_NODES": 20
      }
    }
  }
}
