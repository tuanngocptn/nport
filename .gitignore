# Dependencies
node_modules/
.pnpm-store/

# Build output — nothing built is ever committed (ADR-0006, R13)
target/
dist/
.next/
.open-next/
.turbo/
out/
build/
coverage/
*.tsbuildinfo

# Cloudflare
.wrangler/
.dev.vars
.dev.vars.*
# The template is committed on purpose: `pnpm dev:api` returns an opaque 500 without a
# `.dev.vars`, so the copy-me file has to be discoverable. It holds no real secret.
!.dev.vars.example
worker-configuration.d.ts
# Rewritten by `next dev` and `next build` on every run, like the line above.
apps/web/next-env.d.ts

# Tauri
apps/desktop/src-tauri/gen/

# Local environment
.env
.env.*
!.env.example
.direnv/

# Editors and OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs and temporary files
*.log
npm-debug.log*
.pnpm-debug.log*
*.pending-snap

# Claude Code's scratch worktrees. Each is a full git repository, so `git add -A` picks it up as a
# gitlink — a commit pointing at a clone nobody else has. Ignored rather than remembered.
.claude/worktrees/
