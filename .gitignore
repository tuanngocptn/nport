# Dependencies
node_modules/
.pnpm-store/

# Build output — nothing built is ever committed (ADR-0006, R13)
target/
dist/
.next/
.open-next/
.turbo/
out/
build/
coverage/
*.tsbuildinfo

# Cloudflare
.wrangler/
.dev.vars
.dev.vars.*
# The template is committed on purpose: `pnpm dev:api` returns an opaque 500 without a
# `.dev.vars`, so the copy-me file has to be discoverable. It holds no real secret.
!.dev.vars.example
worker-configuration.d.ts
# Rewritten by `next dev` and `next build` on every run, like the line above.
apps/web/next-env.d.ts

# Tauri
apps/desktop/src-tauri/gen/

# Local environment
.env
.env.*
!.env.example
.direnv/

# CodeGraph's index: a derived SQLite database, rebuilt from source in seconds and stale the
# moment anyone else commits. Everything else CodeGraph writes — `codegraph.json`, `.mcp.json`,
# `.claude/CLAUDE.md`, the `UserPromptSubmit` hook in `.claude/settings.json` — is committed on
# purpose, so the tool is set up for everyone who clones. `docs/CONTRIBUTING.md` says how to get it.
.codegraph/

# Personal Claude Code overrides. The committed `.claude/settings.json` is the team's.
.claude/settings.local.json

# Editors and OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs and temporary files
*.log
npm-debug.log*
.pnpm-debug.log*
*.pending-snap

# Claude Code's scratch worktrees. Each is a full git repository, so `git add -A` picks it up as a
# gitlink — a commit pointing at a clone nobody else has. Ignored rather than remembered.
.claude/worktrees/

# Terraform — state, plans, and the local configs that hold account identifiers.
# `terraform.tfstate` should never appear: the backend is R2 (infra/terraform/README.md).
# `.terraform.lock.hcl` is deliberately NOT here — it pins provider versions and hashes, and CI
# reproducing a plan depends on it, the same argument as `rust-toolchain.toml` and the pnpm lockfile.
.terraform/
*.tfstate
*.tfstate.*
tfplan
backend.hcl
terraform.tfvars
