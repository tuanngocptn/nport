{
  "name": "nport-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Monorepo root for NPort v3. The published npm package is generated by `cargo xtask npm-packages`, not from this manifest.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuanngocptn/nport.git"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "codegen": "turbo run codegen",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "dev:api": "pnpm --filter @nport/api dev",
    "dev:web": "pnpm --filter @nport/web dev",
    "dev:desktop": "pnpm --filter @nport/desktop dev",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "lefthook": "2.1.10",
    "turbo": "2.10.8"
  }
}
