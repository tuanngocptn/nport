{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".nvmrc", "biome.jsonc", "pnpm-workspace.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", ".open-next/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "codegen": {
      "cache": false
    }
  }
}
